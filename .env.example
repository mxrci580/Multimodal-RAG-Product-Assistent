# ==============================================================================
# Google Gemini API Key (Required for Embedding and Vision-Language Generation)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Either GEMINI_API_KEY or GOOGLE_API_KEY can be provided.
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Server Configuration (for Render and production deployment)
HOST=0.0.0.0
PORT=8000

# Vector Database Configuration
VECTOR_DB_PATH=./vector_db
COLLECTION_NAME=products

# Model Configurations
EMBEDDING_MODEL=gemini-embedding-2
LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_MODEL=gemini-flash-lite-latest
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
